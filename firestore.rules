rules_version = '2';
// montessoriokulu.com — Firestore güvenlik kuralları
// profiller: her üye yalnızca kendi profilini okur/yazar; "onayli" alanını yalnızca yönetici değiştirir.
// gonderiler / cevaplar: herkes yayındakileri okur; üyeler kendi adına yazar;
//   onaylı olmayan üyenin gönderisi "beklemede" başlar, yönetici onaylayınca yayına girer.
// bildirimler: üyeler uygunsuz içeriği bildirir; yalnızca yönetici okur.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function yonetici() {
      return girisli() && request.auth.token.email_verified == true
        && request.auth.token.email in ['emrahby@gmail.com', 'eposta@bircicekkoleji.com'];
    }
    function onayliUye() {
      return girisli()
        && exists(/databases/$(database)/documents/profiller/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiller/$(request.auth.uid)).data.get('onayli', false) == true;
    }
    function gecerliDurum(d) {
      return d.durum == 'beklemede' || (d.durum == 'yayinda' && (onayliUye() || yonetici()));
    }
    function gecerliAd(d) {
      return d.yazar_ad is string && d.yazar_ad.size() >= 2 && d.yazar_ad.size() <= 60
        && (!('yazar_tip' in d) || d.yazar_tip in ['ebeveyn', 'ogretmen', 'merakli']);
    }

    // ── PROFİLLER ──
    match /profiller/{uid} {
      function kendisi() { return girisli() && request.auth.uid == uid; }
      function gecerliAlanlar() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'ad_soyad', 'uyelik_tipi', 'cocuk_yasi',
                                 'okul_adi', 'gorev', 'ilgi_alanlari', 'onayli', 'olusturma', 'guncelleme'])
          && (!('uyelik_tipi' in d) || d.uyelik_tipi in ['ebeveyn', 'ogretmen', 'merakli'])
          && (!('gorev' in d) || d.gorev == null
              || d.gorev in ['montessori_ogretmeni', 'asistan', 'yonetici', 'ogretmen_adayi', 'diger'])
          && (!('ilgi_alanlari' in d) || (d.ilgi_alanlari is list && d.ilgi_alanlari.size() <= 8
              && d.ilgi_alanlari.hasOnly(['hazirlanmis_ortam', 'gunluk_yasam', 'hassas_donemler', 'matematik',
                                          'dil', 'orman_okulu', 'okul_secimi', 'ev_uygulamalari'])))
          && (!('ad_soyad' in d) || d.ad_soyad == null || (d.ad_soyad is string && d.ad_soyad.size() <= 120))
          && (!('cocuk_yasi' in d) || d.cocuk_yasi == null || (d.cocuk_yasi is string && d.cocuk_yasi.size() <= 40))
          && (!('okul_adi' in d) || d.okul_adi == null || (d.okul_adi is string && d.okul_adi.size() <= 120));
      }
      // Üye "onayli" alanını kendisi ekleyemez ya da değiştiremez
      function onayDegismedi() {
        return request.resource.data.get('onayli', null) == resource.data.get('onayli', null);
      }

      allow read: if kendisi() || yonetici();
      allow create: if kendisi() && gecerliAlanlar() && !('onayli' in request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if (kendisi() && gecerliAlanlar() && onayDegismedi()
                        && request.resource.data.email == resource.data.email)
        || (yonetici() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onayli'])
            && request.resource.data.onayli is bool);
      allow delete: if false;
    }

    // ── GÖNDERİLER (soru, deneyim, üye rehberi) ──
    match /gonderiler/{gid} {
      function gecerliGonderi() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tur', 'baslik', 'metin', 'kategori', 'yas', 'yazar_uid', 'yazar_ad',
                                 'yazar_tip', 'durum', 'olusturma', 'cevap_sayisi'])
          && d.keys().hasAll(['tur', 'baslik', 'metin', 'kategori', 'yazar_uid', 'yazar_ad', 'durum', 'olusturma', 'cevap_sayisi'])
          && d.yazar_uid == request.auth.uid
          && d.tur in ['soru', 'deneyim', 'rehber']
          && d.baslik is string && d.baslik.size() >= 5 && d.baslik.size() <= 140
          && d.metin is string && d.metin.size() >= 10
          && (d.metin.size() <= 4000 || (d.tur == 'rehber' && d.metin.size() <= 12000))
          && d.kategori in ['ev-ortami', 'gunluk-yasam', 'gelisim', 'dil', 'matematik', 'duygular-davranis',
                            'okul-secimi', 'sinif-yonetimi', 'materyaller', 'orman-okulu', 'diger']
          && (!('yas' in d) || d.yas in ['0-3', '3-6', '6-12', 'genel'])
          && gecerliAd(d)
          && d.olusturma == request.time
          && d.cevap_sayisi == 0
          && gecerliDurum(d);
      }
      allow read: if resource.data.durum == 'yayinda'
        || (girisli() && resource.data.yazar_uid == request.auth.uid) || yonetici();
      allow create: if girisli() && gecerliGonderi();
      // Yayındaki gönderiye cevap verildiğinde cevap sayısı bir artırılabilir; geri kalanı yönetici
      allow update: if yonetici()
        || (girisli() && resource.data.durum == 'yayinda'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cevap_sayisi'])
            && request.resource.data.cevap_sayisi == resource.data.cevap_sayisi + 1);
      allow delete: if yonetici() || (girisli() && resource.data.yazar_uid == request.auth.uid);
    }

    // ── CEVAPLAR ──
    match /cevaplar/{cid} {
      function gecerliCevap() {
        let d = request.resource.data;
        return d.keys().hasOnly(['gonderi_id', 'metin', 'yazar_uid', 'yazar_ad', 'yazar_tip', 'uzman', 'durum', 'olusturma'])
          && d.keys().hasAll(['gonderi_id', 'metin', 'yazar_uid', 'yazar_ad', 'durum', 'olusturma'])
          && d.yazar_uid == request.auth.uid
          && d.gonderi_id is string
          && get(/databases/$(database)/documents/gonderiler/$(d.gonderi_id)).data.durum == 'yayinda'
          && d.metin is string && d.metin.size() >= 2 && d.metin.size() <= 4000
          && (!('uzman' in d) || d.uzman == false || (d.uzman == true && yonetici()))
          && gecerliAd(d)
          && d.olusturma == request.time
          && gecerliDurum(d);
      }
      allow read: if resource.data.durum == 'yayinda'
        || (girisli() && resource.data.yazar_uid == request.auth.uid) || yonetici();
      allow create: if girisli() && gecerliCevap();
      allow update: if yonetici();
      allow delete: if yonetici() || (girisli() && resource.data.yazar_uid == request.auth.uid);
    }

    // ── BİLDİRİMLER (uygunsuz içerik) ──
    match /bildirimler/{bid} {
      allow create: if girisli()
        && request.resource.data.keys().hasOnly(['hedef_tur', 'hedef_id', 'gonderi_id', 'neden', 'bildiren_uid', 'olusturma'])
        && request.resource.data.bildiren_uid == request.auth.uid
        && request.resource.data.hedef_tur in ['gonderi', 'cevap']
        && request.resource.data.hedef_id is string
        && request.resource.data.neden is string && request.resource.data.neden.size() <= 300
        && request.resource.data.olusturma == request.time;
      allow read, delete: if yonetici();
      allow update: if false;
    }

    // ── ÖĞRETMEN KARTLARI ──
    // "acik" true ise herkes okur (e-posta gibi iletişim bilgisi bu belgede hiç tutulmaz).
    // Öğretmen kendi kartını yazar; "dogrulamalar" alanını yalnızca yönetici yazar.
    match /ogretmenler/{uid} {
      function kendisi() { return girisli() && request.auth.uid == uid; }
      function ogretmenUye() {
        return exists(/databases/$(database)/documents/profiller/$(request.auth.uid))
          && get(/databases/$(database)/documents/profiller/$(request.auth.uid)).data.get('uyelik_tipi', '') == 'ogretmen';
      }
      function metin(d, alan, azami) {
        return !(alan in d) || d[alan] == null || (d[alan] is string && d[alan].size() <= azami);
      }
      function gecerliKart() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ad_soyad', 'unvan', 'kurum', 'deneyim_yil', 'egitim', 'sertifikalar',
                                 'tanitim', 'acik', 'guncelleme', 'dogrulamalar'])
          && d.ad_soyad is string && d.ad_soyad.size() >= 2 && d.ad_soyad.size() <= 80
          && metin(d, 'unvan', 80) && metin(d, 'kurum', 120) && metin(d, 'tanitim', 400)
          && (!('deneyim_yil' in d) || d.deneyim_yil == null
              || (d.deneyim_yil is int && d.deneyim_yil >= 0 && d.deneyim_yil <= 60))
          && (!('egitim' in d) || (d.egitim is list && d.egitim.size() <= 5))
          && (!('sertifikalar' in d) || (d.sertifikalar is list && d.sertifikalar.size() <= 8))
          && d.acik is bool
          && d.guncelleme == request.time;
      }
      function dogrulamaDegismedi() {
        return request.resource.data.get('dogrulamalar', null) == resource.data.get('dogrulamalar', null);
      }

      allow read: if resource.data.acik == true || kendisi() || yonetici();
      allow create: if kendisi() && ogretmenUye() && gecerliKart() && !('dogrulamalar' in request.resource.data);
      allow update: if (kendisi() && gecerliKart() && dogrulamaDegismedi())
        || (yonetici() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dogrulamalar'])
            && request.resource.data.dogrulamalar is map);
      allow delete: if kendisi() || yonetici();
    }

    // ── BELGE BAŞVURULARI (öğretmenin doğrulama isteği) ──
    // Yalnızca sahibi ve yönetici okur. Kararı yalnızca yönetici verir.
    match /belge_basvurulari/{bid} {
      function gecerliBasvuru() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'kalem_id', 'kalem_tur', 'kalem_ad', 'dosya_yolu', 'not', 'durum', 'olusturma'])
          && d.keys().hasAll(['uid', 'kalem_id', 'kalem_tur', 'kalem_ad', 'durum', 'olusturma'])
          && d.uid == request.auth.uid
          && d.kalem_id is string && d.kalem_id.size() >= 1 && d.kalem_id.size() <= 24
          && d.kalem_tur in ['egitim', 'sertifika']
          && d.kalem_ad is string && d.kalem_ad.size() <= 260
          && (!('dosya_yolu' in d) || d.dosya_yolu == null
              || (d.dosya_yolu is string && d.dosya_yolu.matches('belgeler/' + request.auth.uid + '/[^/]+')))
          && (!('not' in d) || d.not == null || (d.not is string && d.not.size() <= 300))
          && d.durum == 'bekliyor'
          && d.olusturma == request.time;
      }
      allow create: if girisli() && gecerliBasvuru();
      allow read: if (girisli() && resource.data.uid == request.auth.uid) || yonetici();
      allow update: if yonetici()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'karar_tarihi', 'yonetici_notu'])
        && request.resource.data.durum in ['onaylandi', 'reddedildi'];
      allow delete: if yonetici()
        || (girisli() && resource.data.uid == request.auth.uid && resource.data.durum == 'bekliyor');
    }

    // Başka hiçbir koleksiyona erişim yok
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
